# --- Local model servers: plain API URLs, NO api key required ---
MXBAI_API_URL=http://localhost:8000/embed
GEMMA_API_URL=http://localhost:8001/v1/chat/completions
EMBED_DIM=1024

# --- Qdrant (vector DB, local docker) ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=kgra_chunks

# --- Neo4j (graph DB, local docker) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme123

# --- Paths ---
PDF_DIR=./data/pdfs
PROCESSED_DIR=./data/processed

# --- Chunking / retrieval tuning ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K_VECTOR=5
TOP_K_BM25=5
TOP_K_FINAL=5
GRAPH_DEPTH=2
